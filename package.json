{
  "name": "newsie-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "app",
    "packages/*",
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "format": "yarn workspaces foreach -A exec oxfmt",
    "format:check": "yarn workspaces foreach -A exec oxfmt --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cspell": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.63.0",
    "storybook": "^10.5.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@4.18.0"
}
